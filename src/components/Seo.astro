---
import { site } from '../data/site';
import kingaImg from '../assets/img/kinga-adamus-hero.jpg';
import { getImage } from 'astro:assets';

export type Crumb = { name: string; href: string };
interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  breadcrumbs?: Crumb[];
  published?: Date;
  modified?: Date;
  jsonLd?: Record<string, unknown>[];
  pageType?: string; // WebPage, AboutPage, ContactPage, FAQPage, CollectionPage
}

const {
  title,
  description,
  image = '/og/default.png',
  type = 'website',
  noindex = false,
  breadcrumbs = [],
  published,
  modified,
  jsonLd = [],
  pageType = 'WebPage',
} = Astro.props;

const base = site.url;
const canonical = new URL(Astro.url.pathname, base).toString();
const fullTitle = title.includes('Proxima Legal') || title.length > 48 ? title : `${title} | Proxima Legal`;
const ogImage = new URL(image, base).toString();
const kinga = await getImage({ src: kingaImg, width: 800, format: 'jpg' });

const ORG = `${base}/#kancelaria`;
const PERSON = `${base}/o-nas/#kinga-adamus`;
const WEBSITE = `${base}/#website`;

const address: Record<string, string> = { '@type': 'PostalAddress', addressLocality: site.address.city, addressCountry: site.address.country };
if (site.address.street) address.streetAddress = site.address.street;
if (site.address.postalCode) address.postalCode = site.address.postalCode;

const org: Record<string, unknown> = {
  '@type': ['LegalService', 'Organization'],
  '@id': ORG,
  name: site.name,
  url: `${base}/`,
  logo: { '@type': 'ImageObject', url: `${base}/logo-512.png`, width: 512, height: 512 },
  image: `${base}/og/default.png`,
  description: site.description,
  slogan: 'Prawo, które nadąża za Twoim biznesem.',
  email: site.email,
  address,
  areaServed: { '@type': 'Country', name: 'Polska' },
  availableLanguage: ['pl'],
  founder: { '@id': PERSON },
  employee: [{ '@id': PERSON }],
  knowsAbout: [
    'prawo spółek handlowych', 'zakładanie i rejestracja spółek', 'umowy B2B', 'rundy finansowania', 'transakcje M&A',
    'due diligence', 'restrukturyzacja przedsiębiorstw', 'prawo upadłościowe', 'odpowiedzialność członków zarządu',
    'odszkodowania i utracone korzyści', 'kary umowne',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Oferta Proxima Legal',
    itemListElement: [
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Abonament prawny', url: `${base}/abonament-prawny/` } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Legal Rescue', url: `${base}/legal-rescue/` } },
      { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Doradztwo strategiczne', url: `${base}/doradztwo-strategiczne/` } },
    ],
  },
};
if (site.phone) org.telephone = site.phone;
if (site.legalName) org.legalName = site.legalName;
if (site.nip) org.taxID = site.nip;

const person: Record<string, unknown> = {
  '@type': 'Person',
  '@id': PERSON,
  name: site.founder.name,
  jobTitle: 'Założycielka Proxima Legal',
  worksFor: { '@id': ORG },
  image: new URL(kinga.src, base).toString(),
  url: `${base}/o-nas/`,
  knowsAbout: ['prawo gospodarcze', 'prawo spółek', 'umowy wspólników', 'term sheet', 'transakcje M&A', 'umowy B2B'],
};

const website = {
  '@type': 'WebSite',
  '@id': WEBSITE,
  url: `${base}/`,
  name: site.name,
  inLanguage: 'pl-PL',
  publisher: { '@id': ORG },
};

const crumbs = breadcrumbs.length
  ? {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumbs`,
      itemListElement: [{ name: 'Strona główna', href: '/' }, ...breadcrumbs].map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.href, base).toString(),
      })),
    }
  : null;

const webpage: Record<string, unknown> = {
  '@type': pageType,
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: fullTitle,
  description,
  inLanguage: 'pl-PL',
  isPartOf: { '@id': WEBSITE },
  about: { '@id': ORG },
  primaryImageOfPage: { '@type': 'ImageObject', url: ogImage },
};
if (crumbs) webpage.breadcrumb = { '@id': `${canonical}#breadcrumbs` };
if (modified) webpage.dateModified = modified.toISOString();

const graph = { '@context': 'https://schema.org', '@graph': [org, person, website, webpage, ...(crumbs ? [crumbs] : []), ...jsonLd] };
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
<meta property="og:type" content={type} />
<meta property="og:locale" content="pl_PL" />
<meta property="og:site_name" content="Proxima Legal" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
{type === 'article' && modified && <meta property="article:modified_time" content={modified.toISOString()} />}
{type === 'article' && <meta property="article:author" content={site.founder.name} />}
<script type="application/ld+json" set:html={JSON.stringify(graph)} />
