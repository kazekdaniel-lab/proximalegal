---
// Diagram "Osobni doradcy" vs "Proxima": ta sama trójka specjalistów, raz osobno, raz w jednym zespole.
const L = { c: [140, 172], a: [60, 98], b: [220, 98], d: [140, 262] };
const R = { c: [460, 172], a: [380, 126], b: [540, 126], d: [460, 264] };
const nodes = [
  { k: 'a', label: 'Prawnik', glyph: '§' },
  { k: 'b', label: 'Księgowa', glyph: 'zł' },
  { k: 'd', label: 'Doradca', glyph: '%' },
] as const;
const labelPos = (p: number[], k: string) => (k === 'd' ? [p[0], p[1] + 44] : [p[0], p[1] - 34]);
---
<figure class="team-diagram">
  <svg viewBox="0 0 600 330" role="img" aria-labelledby="td-title td-desc">
    <title id="td-title">Osobni doradcy a jeden zespół</title>
    <desc id="td-desc">Po lewej prawnik, księgowa i doradca pracują z firmą osobno, każdy na własnej umowie. Po prawej ci sami specjaliści tworzą jeden zespół połączony wokół firmy.</desc>

    <text x="140" y="22" text-anchor="middle">Osobni doradcy</text>
    <text x="460" y="22" text-anchor="middle" class="t-mint t-strong">Proxima</text>
    <line x1="300" y1="44" x2="300" y2="310" class="ln" stroke-dasharray="2 6" />

    {nodes.map((n) => (
      <line x1={L[n.k][0]} y1={L[n.k][1]} x2={L.c[0]} y2={L.c[1]} class="ln" stroke-dasharray="5 5" />
    ))}
    {nodes.map((n) => (
      <g>
        <circle cx={L[n.k][0]} cy={L[n.k][1]} r="22" class="node" />
        <text x={L[n.k][0]} y={L[n.k][1] + 5} text-anchor="middle" class="t-strong">{n.glyph}</text>
        <text x={labelPos(L[n.k], n.k)[0]} y={labelPos(L[n.k], n.k)[1]} text-anchor="middle">{n.label}</text>
      </g>
    ))}
    <circle cx={L.c[0]} cy={L.c[1]} r="27" class="core" />
    <text x={L.c[0]} y={L.c[1] - 2} text-anchor="middle" class="t-core">Twoja</text>
    <text x={L.c[0]} y={L.c[1] + 11} text-anchor="middle" class="t-core">firma</text>

    <path class="ln-mint draw" d={`M ${R.c[0]} ${R.c[1] - 96} a 96 96 0 1 1 -0.01 0`} />
    <path class="ln-mint draw" d={`M ${R.a[0]} ${R.a[1]} L ${R.b[0]} ${R.b[1]} L ${R.d[0]} ${R.d[1]} Z`} opacity=".55" />
    {nodes.map((n) => (
      <path class="ln-mint draw" d={`M ${R[n.k][0]} ${R[n.k][1]} L ${R.c[0]} ${R.c[1]}`} />
    ))}
    {nodes.map((n) => (
      <g>
        <circle cx={R[n.k][0]} cy={R[n.k][1]} r="22" class="node-mint" />
        <text x={R[n.k][0]} y={R[n.k][1] + 5} text-anchor="middle" class="t-mint t-strong">{n.glyph}</text>
      </g>
    ))}
    <text x="380" y="80" text-anchor="middle">Prawnik</text>
    <text x="540" y="80" text-anchor="middle">Księgowa</text>
    <text x="460" y="318" text-anchor="middle">Doradca</text>
    <circle cx={R.c[0]} cy={R.c[1]} r="27" class="core" />
    <text x={R.c[0]} y={R.c[1] - 2} text-anchor="middle" class="t-core">Twoja</text>
    <text x={R.c[0]} y={R.c[1] + 11} text-anchor="middle" class="t-core">firma</text>
  </svg>
</figure>
