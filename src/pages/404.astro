---
import Base from '../layouts/Base.astro';
---
<Base title="Nie ma takiej strony" description="Strona nie istnieje albo zmieniła adres." noindex>
  <section class="section not-found">
    <div class="container container--narrow">
      <p class="kicker">Błąd 404</p>
      <h1 class="h1">Tej strony nie ma pod tym adresem.</h1>
      <p class="lead mt-m">Adres mógł się zmienić po przebudowie strony. Zacznij od jednej z tych stron:</p>
      <ul class="dashlist mt-m">
        <li><a class="link" href="/abonament-prawny/">Abonament prawny</a></li>
        <li><a class="link link--rescue" href="/legal-rescue/">Legal Rescue: spółka traci płynność</a></li>
        <li><a class="link" href="/baza-wiedzy/">Baza wiedzy</a></li>
        <li><a class="link" href="/legal/">Opracowania prawne</a></li>
        <li><a class="link" href="/kontakt/">Kontakt</a></li>
      </ul>
    </div>
  </section>
</Base>
