---
import { Image, Picture } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import LifeAxis from '../components/LifeAxis.astro';
import TeamDiagram from '../components/TeamDiagram.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { specializations } from '../data/specializations';
import { homeFacts, startSteps, oneTeam, rescue } from '../data/offer';
import { firstParagraphs } from '../lib/text';
import { formatPrice } from '../data/site';
import kinga from '../assets/img/kinga-adamus-biurko.jpg';
import heroImg from '../assets/img/kinga-adamus-hero.jpg';
import ctaImg from '../assets/img/kinga-adamus-dokumenty.jpg';

const bw = await getCollection('baza-wiedzy');
const featured = ['odpowiedzialnosc-zarzadu-art-299-ksh', 'jak-zalozyc-spolke-z-oo', 'bledy-w-umowach-b2b']
  .map((id) => bw.find((a) => a.id === id))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

const legal = (await getCollection('legal')).sort((a, b) => a.data.title.localeCompare(b.data.title, 'pl'));
const flagship = legal.find((e) => e.id === 'utracona-korzysc');
const order = ['utracona-korzysc', 'kara-umowna-a-odszkodowanie', 'umowne-ograniczenie-odpowiedzialnosci', 'przedawnienie-roszczen-odszkodowawczych', 'odsetki-i-rekompensata-w-transakcjach-handlowych'];
const legalSorted = order.map((id) => legal.find((e) => e.id === id)).filter((e): e is NonNullable<typeof e> => Boolean(e));
const sheetParas = flagship ? firstParagraphs(flagship.body ?? '', 2, 420) : [];
const priceFmt = formatPrice(rescue.price);

const faqHome = {
  '@type': 'ItemList',
  name: 'Specjalizacje Proxima Legal',
  itemListElement: specializations.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.title, url: `https://proximalegal.pl/specjalizacje/${s.slug}/` })),
};
---
<Base
  title="Proxima Legal: kancelaria dla spółek w Warszawie"
  description="Kancelaria dla spółek: rejestracja, rundy i M&A, bieżąca obsługa w stałym ryczałcie oraz Legal Rescue dla spółek w kryzysie. Bezpłatna konsultacja 30 min."
  jsonLd={[faqHome]}
>
  <section class="hero hero--photo dark" aria-labelledby="hero-title">
    <div class="container">
      <div class="hero__top">
        <div class="hero__copy">
          <p class="kicker">Kancelaria dla spółek, Warszawa i online</p>
          <h1 id="hero-title" class="display hero__title">Prawo, które nadąża za Twoim biznesem.</h1>
          <p class="lead hero__lead">Od rejestracji spółki po trudne decyzje. Jeden zespół poznaje Twoją firmę raz i prowadzi ją przez kolejne etapy, w stałym abonamencie albo w trybie kryzysowym.</p>
          <div class="btn-row hero__actions">
            <a class="btn btn--primary" href="/kontakt/">Bezpłatna konsultacja 30 min</a>
            <a class="btn btn--ghost" href="/abonament-prawny/">Zobacz ofertę</a>
          </div>
        </div>
        <figure class="hero__media">
          <Picture src={heroImg} alt="Kinga Adamus, założycielka Proxima Legal, przy stole konferencyjnym w biurze w Warszawie" widths={[480, 640, 840]} sizes="(min-width: 1000px) 50vw, 100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
          <figcaption class="hero__caption"><strong>Kinga Adamus</strong><span>założycielka, prawo gospodarcze</span></figcaption>
        </figure>
      </div>
      <LifeAxis />
      <dl class="facts">
        {homeFacts.map((f) => (<div><dt>{f.value}</dt><dd>{f.label}</dd></div>))}
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="paths-title">
    <div class="container">
      <div class="section-head">
        <p class="kicker mt-0">Dwie drogi wejścia</p>
        <h2 id="paths-title" class="h2">W jakim miejscu jest dziś Twoja spółka?</h2>
      </div>
      <div class="folders">
        <article class="folder" aria-labelledby="f-abo">
          <span class="folder__tab">Firma działa i rośnie</span>
          <h3 id="f-abo" class="h2">Abonament prawny</h3>
          <p>Stały prawnik, ryczałt miesięczny i cztery pakiety. Dobierasz zakres: samo prawo, prawo z księgowością, prawo z doradcą strategicznym albo wszystko razem.</p>
          <ul class="checklist" role="list">
            <li>Umowy, kadry, organy spółki i KRS</li>
            <li>Rundy finansowania i transakcje</li>
            <li>Zmiana pakietu raz na kwartał</li>
          </ul>
          <div class="folder__foot">
            <a class="btn btn--primary" href="/abonament-prawny/">Porównaj pakiety</a>
            <span class="muted small">Wycena po konsultacji</span>
          </div>
        </article>
        <article class="folder folder--rescue" aria-labelledby="f-res">
          <span class="folder__tab">Spółka traci płynność</span>
          <div class="folder__days" aria-hidden="true">{Array.from({ length: 30 }).map(() => <span></span>)}</div>
          <p class="folder__days-label" aria-hidden="true">30 dni od niewypłacalności na wniosek</p>
          <h3 id="f-res" class="h2">Legal Rescue</h3>
          <p>Od dnia, w którym spółka staje się niewypłacalna, zarząd ma 30 dni na wniosek o upadłość. Prawnik i doradca restrukturyzacyjny pomagają wykorzystać ten czas.</p>
          <ul class="checklist" role="list">
            <li>Diagnoza sytuacji i ryzyk zarządu</li>
            <li>Negocjacje z bankami i wierzycielami</li>
            <li>Restrukturyzacja albo uporządkowana upadłość</li>
          </ul>
          <div class="folder__foot">
            <a class="btn btn--rescue" href="/legal-rescue/">Sprawdź Legal Rescue</a>
            <span class="price-tag">od <strong class="num">{priceFmt} zł</strong> netto / mies.</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="spec-title">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="kicker mt-0">Specjalizacje</p>
          <h2 id="spec-title" class="h2">Na każdym etapie życia spółki</h2>
        </div>
        <a class="link" href="/specjalizacje/">Wszystkie specjalizacje</a>
      </div>
      <div class="spec-index" data-spec-index>
        <ol class="spec-list" role="list">
          {specializations.map((s, i) => (
            <li>
              <a class:list={['spec-row', { 'spec-row--rescue': s.tone === 'rescue', 'is-active': i === 0 }]} href={`/specjalizacje/${s.slug}/`} data-spec={s.slug} data-caption={s.imageAlt}>
                <span class="spec-row__no">{s.no}</span>
                <span class="spec-row__stage">{s.stage}</span>
                <span class="spec-row__title">{s.title}</span>
                <span class="spec-row__short">{s.short}</span>
                <span class="spec-row__go">Zobacz zakres</span>
              </a>
            </li>
          ))}
        </ol>
        <div class="spec-preview" aria-hidden="true">
          <div class="spec-preview__frame">
            {specializations.map((s, i) => (
              <Image src={s.image} alt="" widths={[400, 640, 900]} sizes="(min-width: 1000px) 38vw, 1px" format="webp" class={i === 0 ? 'is-active' : ''} data-spec-img={s.slug} loading="lazy" />
            ))}
          </div>
          <p class="spec-preview__caption" data-spec-caption>{specializations[0].imageAlt}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section dark dark--teal" aria-labelledby="team-title">
    <div class="container team-split">
      <div>
        <p class="kicker">Dlaczego jeden zespół</p>
        <h2 id="team-title" class="h2">Płacisz za poznanie firmy raz.</h2>
        <p class="lead mt-m">Kiedy prawnik, księgowa i doradca pracują osobno, każde z nich uczy się Twojej firmy na Twój koszt. U nas robi to jeden zespół, a wiedza zostaje w środku.</p>
      </div>
      <div>
        <TeamDiagram />
        <table class="compare">
          <caption class="visually-hidden">Osobni doradcy a Proxima Legal</caption>
          <thead><tr><th scope="col">Osobni doradcy</th><th scope="col">Proxima</th></tr></thead>
          <tbody>{oneTeam.map((r) => <tr><td>{r.separate}</td><td>{r.proxima}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="who-title">
    <div class="container person">
      <div class="person__photo">
        <Image src={kinga} alt="Kinga Adamus, założycielka Proxima Legal, przy biurku z laptopem" widths={[400, 640, 900]} sizes="(min-width: 900px) 40vw, 100vw" format="webp" loading="lazy" />
      </div>
      <div>
        <p class="kicker">Kto prowadzi Twoją sprawę</p>
        <h2 id="who-title" class="h1 person__name">Kinga Adamus</h2>
        <dl class="meta-list">
          <dt>Rola</dt><dd>założycielka</dd>
          <dt>Specjalizacja</dt><dd>prawo gospodarcze</dd>
        </dl>
        <p class="lead">Prowadzi umowy B2B, struktury spółek i umowy wspólników, a przy transakcjach M&A o wartości od 5 do 100 mln zł negocjuje term sheet, SPA i SHA po stronie sprzedających i kupujących.</p>
        <p class="mt-m"><a class="btn btn--ghost" href="/o-nas/">Poznaj zespół</a></p>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="steps-title">
    <div class="container">
      <div class="section-head">
        <p class="kicker mt-0">Jak zaczynamy</p>
        <h2 id="steps-title" class="h2">Od pierwszej rozmowy do stałej opieki</h2>
      </div>
      <ol class="steps" role="list">
        {startSteps.map((s) => <li><h3 class="h3">{s.t}</h3><p>{s.d}</p></li>)}
      </ol>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="section" aria-labelledby="kb-title">
      <div class="container">
        <div class="section-head section-head--split">
          <div>
            <p class="kicker mt-0">Baza wiedzy</p>
            <h2 id="kb-title" class="h2">Prawo spółek opisane językiem przedsiębiorcy</h2>
          </div>
          <a class="link" href="/baza-wiedzy/">Wszystkie artykuły</a>
        </div>
        <ul class="cards cards--3" role="list">
          {featured.map((a) => (
            <li><ArticleCard href={`/baza-wiedzy/${a.id}/`} title={a.data.title} lead={a.data.lead} category={a.data.category} minutes={a.data.readingTime} /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {legalSorted.length > 0 && (
    <section class="section dark dark--teal" aria-labelledby="legal-title">
      <div class="container legal-teaser">
        <div>
          <p class="kicker">Opracowania prawne</p>
          <h2 id="legal-title" class="h2">Dla prawników i zarządów, które chcą znać podstawę.</h2>
          <p class="lead mt-m">Opracowania w rejestrze komentarza: teza, przesłanki, orzecznictwo i wnioski dla praktyki, z numerami brzegowymi i stanem prawnym.</p>
          <ul class="legal-list mt-l" role="list">
            {legalSorted.map((e) => (
              <li><a href={`/legal/${e.id}/`}><strong>{e.data.shortTitle}</strong><span>{e.data.legalBasis.slice(0, 3).join(', ')}</span><em>Czytaj</em></a></li>
            ))}
          </ul>
          <p class="mt-m"><a class="link" href="/legal/">Wszystkie opracowania</a></p>
        </div>
        {flagship && (
          <a href={`/legal/${flagship.id}/`} class="sheet" aria-label={`Czytaj opracowanie: ${flagship.data.title}`}>
            <div class="sheet__head"><span>Opracowanie</span><span>{flagship.data.legalBasis.slice(0, 2).join(', ')}</span></div>
            <h3>{flagship.data.title}</h3>
            <p class="sheet__thesis">{flagship.data.thesis}</p>
            {sheetParas.map((p, i) => <p class="nb" data-nb={i + 1}>{p}</p>)}
            <span class="sheet__fade" aria-hidden="true"></span>
          </a>
        )}
      </div>
    </section>
  )}

  <CtaBand image={ctaImg} imageAlt="Kinga Adamus czyta umowę przy biurku" />
</Base>
