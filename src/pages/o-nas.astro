---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { partners, workflow } from '../data/offer';
import { site } from '../data/site';
import portrait from '../assets/img/kinga-adamus-dokumenty.jpg';
import office from '../assets/img/biuro-warszawa.jpg';

const crumbs = [{ name: 'O nas', href: '/o-nas/' }];
// Proste ikony ról (linie 1,5 px), rysowane w SVG, bez zewnętrznych bibliotek.
const icons: Record<string, string> = {
  'Doradca strategiczny': '<path d="M8 34 18 24l6 6 12-14" /><path d="M30 16h6v6" />',
  'Licencjonowany doradca restrukturyzacyjny': '<path d="M10 22a12 12 0 1 1 3.5 8.5" /><path d="M10 30v-8h8" />',
  'Biuro rachunkowe': '<rect x="11" y="8" width="22" height="28" rx="2" /><path d="M16 15h12M16 22h4M24 22h4M16 28h4M24 28h4" />',
  'Doradca podatkowy': '<path d="M14 32 30 12" /><circle cx="15" cy="14" r="3" /><circle cx="29" cy="30" r="3" />',
  'Prawnik prawa pracy': '<circle cx="22" cy="15" r="5" /><path d="M12 35c1.5-6 5.5-9 10-9s8.5 3 10 9" />',
  'Notariusz': '<path d="M16 34h12M18 34v-6h8v6M22 28V12" /><circle cx="22" cy="10" r="3" />',
};
---
<Base
  title="O nas: Kinga Adamus i zespół Proxima Legal"
  description="Proxima Legal łączy obsługę prawną spółek z doradztwem finansowym i strategicznym. Poznaj założycielkę Kingę Adamus i sieć partnerów kancelarii."
  breadcrumbs={crumbs}
  pageType="AboutPage"
>
  <section class="page-hero dark" aria-labelledby="page-title">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="kicker">O nas</p>
      <h1 id="page-title" class="h1 page-hero__title">Prawnicy, dla których prawo jest narzędziem biznesu.</h1>
      <p class="lead page-hero__lead">Proxima Legal pracuje dla przedsiębiorców, którzy chcą budować firmy, a nie przekładać dokumenty. Łączymy obsługę prawną z doradztwem finansowym i strategicznym, bo ważne decyzje w spółce rzadko dotyczą samego prawa.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="founder-title">
    <div class="container bio">
      <div class="bio__photo">
        <Image src={portrait} alt="Kinga Adamus czyta umowę przy biurku" widths={[400, 640, 900]} sizes="(min-width: 960px) 38vw, 100vw" format="webp" loading="eager" />
      </div>
      <div>
        <p class="kicker">Założycielka</p>
        <h2 id="founder-title" class="h1">Kinga Adamus</h2>
        <dl class="meta-list mt-m">
          {site.founder.title && <><dt>Tytuł zawodowy</dt><dd>{site.founder.title}</dd></>}
          <dt>Specjalizacja</dt><dd>prawo gospodarcze</dd>
          <dt>Rola</dt><dd>założycielka, prowadząca sprawy spółek</dd>
        </dl>
        <div class="bio__text">
          <p>Kinga prowadzi sprawy spółek od strony umów, struktury i transakcji. Pisze umowy B2B i umowy wspólników, ustawia vesting i analizuje term sheety dla startupów.</p>
          <p>Przy transakcjach M&A o wartości od 5 do 100 mln zł prowadzi proces od term sheetu, przez due diligence, po negocjacje SPA i SHA, escrow i earn-out. Pracuje zarówno dla sprzedających founderów, jak i dla kupujących.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="team-title">
    <div class="container">
      <div class="section-head">
        <p class="kicker mt-0">Zespół i partnerzy</p>
        <h2 id="team-title" class="h2">Jeden prowadzący i sieć specjalistów</h2>
        <p class="lead">Sprawę prowadzi stała osoba. Gdy potrzebna jest księgowość, podatki czy restrukturyzacja, włączamy partnerów, z którymi pracujemy na co dzień. Rozliczasz się z nami w jednym ryczałcie.</p>
      </div>
      <ul class="roles" role="list">
        {partners.map((p) => (
          <li>
            <svg viewBox="0 0 44 44" aria-hidden="true" fill="none" stroke="#0E5A52" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={icons[p.role] ?? ''} /></svg>
            <div>
              <h3>{p.role}</h3>
              <p>{p.d}</p>
              {p.name && <p><strong>{p.name}</strong></p>}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="wf-title">
    <div class="container">
      <div class="section-head">
        <p class="kicker mt-0">Jak pracujemy</p>
        <h2 id="wf-title" class="h2">Współpraca krok po kroku</h2>
      </div>
      <ol class="steps steps--5" role="list">
        {workflow.map((s) => <li><h3 class="h3">{s.t}</h3><p>{s.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="office-title">
    <div class="container office">
      <Image src={office} alt="Biuro Proxima Legal w Warszawie: stół, laptop i widok na miasto" widths={[600, 900, 1300]} sizes="(min-width: 960px) 55vw, 100vw" format="webp" loading="lazy" />
      <div>
        <p class="kicker">Biuro</p>
        <h2 id="office-title" class="h2">Warszawa</h2>
        {site.address.street && <p class="lead mt-s">{site.address.street}, {site.address.postalCode} Warszawa</p>}
        <p class="mt-s muted">Z klientami spoza Warszawy pracujemy zdalnie. Spotkania na miejscu umawiamy według potrzeb.</p>
        <p class="mt-m"><a class="btn btn--ghost" href="/kontakt/">Kontakt</a></p>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .steps--5 { --cols: 5; }
  @media (min-width: 900px) and (max-width: 1199px) { .steps--5 { --cols: 3; } .steps--5 li:nth-child(3)::after { display: none; } }
</style>
